# ~/Library/Mobile Documents/com~apple~CloudDocs/second-brain/config.yaml
# Copy this file to the path above and fill in your values.

daemon:
  role: full
  # Role controls which tasks this machine runs. Set per-machine in a local
  # override or just edit before launch. Valid values:
  #
  #   full     — browser_watcher + telegram bot + index_builder + skill_optimizer
  #              Run on your primary always-on machine (Mac Studio / Mac Mini).
  #              Needs ANTHROPIC_API_KEY + GEMINI_API_KEY.
  #
  #   watcher  — browser_watcher only. Summarizes pages visited on this machine,
  #              writes memory files to iCloud. No Telegram, no index, no optimizer.
  #              Only needs GEMINI_API_KEY (summarize-webpage uses gemini-flash).
  #              Run on MacBook Pro when traveling.

user:
  telegram_user_id: YOUR_TELEGRAM_USER_ID   # whitelist — bot ignores all others
  name: Chris
  timezone: America/Los_Angeles

telegram:
  bot_token: YOUR_BOT_TOKEN                 # from @BotFather — only needed on full node

browser_watcher:
  interval_seconds: 300          # poll every 5 minutes
  min_dwell_seconds: 30          # ignore pages visited < 30s
  min_content_chars: 500         # ignore stubs, redirects
  skip_domains:                  # noise filter — edit here or via /skip in Telegram
    - google.com
    - googleadservices.com
    - doubleclick.net
    - facebook.com
    - twitter.com
    - t.co
    - linkedin.com
    - youtube.com                # optional — remove if you want YT titles captured

litellm:
  # Local endpoints (optional)
  providers:
    - name: mac-studio
      api_base: http://mac-studio.local:8000/v1
      api_key: none
      models: [nemotron-cascade-2]

skill_optimizer:
  run_hour: 3                       # 3am daily
  min_runs_before_optimize: 10      # don't optimize on sparse data
  underperformance_threshold: 0.70  # optimize if success_rate < this
  skip_above_threshold: 0.90        # skip if success_rate >= this
  regression_tolerance: 0.05        # rollback if new avg drops more than this
  max_exemplars: 2                  # top-N scoring traces to embed as few-shot examples
  max_history_rows: 100             # prune execution history beyond this
  max_skill_backups: 5              # rolling backup files to keep (.1 through .N)
  judge_model: judge                # LiteLLM route for judge calls
  dry_run: false                    # log changes without writing files

memory:
  max_context_memories: 20       # max files loaded into chat context
  index_rebuild_interval: 3600   # rebuild index.md every hour

goals:
  categories:                    # configurable category list for goals and projects
    - personal
    - work
    - family
    - learning
    - other

code_scanner:
  interval_seconds: 300          # scan every 5 minutes
  repo_dirs:                     # directories to search for git repos
    - ~/repos
    - ~/repo
  skip_repos: []                 # repo directory names to ignore (e.g. [archived-project])
  require_confirmation: false    # set true to require /confirm before indexing new repos

email_scanner:
  interval_seconds: 300          # scan every 5 minutes
  initial_lookback_days: 30      # first scan: how far back to go (max 90)
  archive_after_days: 90         # stop updating threads inactive this long
  classification_enabled: true   # LLM classifies emails as human/transactional/marketing/automated
  skip_mailboxes:                # mailbox names to exclude (case-insensitive)
    - Trash
    - Junk
    - Spam
    - Archive
    - Deleted Messages
  full_rescan: false             # set true to force a full rescan next cycle

zoom_scanner:
  interval_seconds: 300          # poll every 5 minutes
  initial_lookback_days: 30      # first run: how far back to look for recordings

commitment_tracker:
  interval_seconds: 300          # scan every 5 minutes
  min_confidence: 0.5            # discard items below this threshold
  source_types:                  # memory types to scan for commitments
    - meeting_transcript
    - email_thread
    - calendar_event
    - slack_thread

contact_tracker:
  interval_seconds: 300          # scan every 5 minutes
  source_types:                  # memory types to scan for participants
    - email_thread
    - meeting_transcript
    - calendar_event
    - slack_thread
  summary_refresh_threshold: 3   # new interactions before regenerating LLM summary
  max_files_per_cycle: 50

slack_scanner:
  interval_seconds: 300          # scan every 5 minutes
  lookback_days: 7               # initial history window on first run per channel
  channel_include: []            # whitelist — filters the user's auto-discovered channel set (empty = all channels you're a member of)
  channel_exclude:               # blacklist — applied when include is empty
    - general
    - random
  min_thread_messages: 2         # skip threads with fewer replies than this
  max_channels_per_cycle: 20
  max_threads_per_channel: 30

calendar_scanner:
  interval_seconds: 300          # scan every 5 minutes
  lookback_days: 7               # events up to N days in the past
  forward_days: 7                # events up to N days in the future
  skip_calendars: []             # calendar names to exclude (e.g. ["Birthdays", "Holidays"])
  max_events_per_cycle: 50

project_inference:
  enabled: true                  # infer projects from emails, meetings, Slack threads
  scan_interval_min: 15          # scan every 15 minutes
  confidence_threshold: 0.7      # minimum confidence to create a candidate
  source_types:                  # memory types to scan for project mentions
    - email_thread
    - meeting_transcript
    - slack_thread

notifications:
  enabled: true
  briefing_time: "07:30"           # local time (uses user.timezone)
  pre_meeting_minutes: 10          # push context N minutes before events
  stale_waiting_on_days: 7         # waiting-ons older than N days appear in briefing
  telegram_chat_id: null           # auto-detected from first message if null

# GitHub Issues backing for /feature and /bug (optional)
# If GITHUB_PAT and GITHUB_REPO env vars are set (via install.sh), they take
# precedence. Set github.repo here to configure the repo without an env var.
# github:
#   repo: chrisrobertson/secondbrain
