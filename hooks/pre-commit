#!/bin/sh
# Pre-commit hook: run pytest before every commit to gate broken code off main.
# Install: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# The installer (install.sh) does this automatically.
set -e

VENV_PYTEST="$HOME/secondbrain/venv/bin/pytest"
REPO_DIR="$(git rev-parse --show-toplevel)"

if [ -x "$VENV_PYTEST" ]; then
    PYTEST="$VENV_PYTEST"
elif command -v pytest >/dev/null 2>&1; then
    PYTEST="pytest"
else
    echo "  pre-commit: pytest not found — install dev dependencies and re-run install.sh"
    echo "  Skipping test gate (no pytest available)"
    exit 0
fi

echo "  pre-commit: running pytest..."
cd "$REPO_DIR"
"$PYTEST" -q --tb=short
